# Copy to deploy/frontend/.env on the server. The repository ignores that file.
# Use two separate Supabase projects so preview writes never reach production.
KFAAH_RELEASE=local
KFAAH_PROD_SUPABASE_URL=
KFAAH_PROD_PUBLISHABLE_KEY=
KFAAH_PROD_PROJECT_ID=
KFAAH_PREVIEW_SUPABASE_URL=
KFAAH_PREVIEW_PUBLISHABLE_KEY=
KFAAH_PREVIEW_PROJECT_ID=
